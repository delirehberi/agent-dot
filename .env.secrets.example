# Copy this file to .env.secrets and fill in your credentials:
#   cp .env.secrets.example .env.secrets
#   chmod 600 .env.secrets

# Figma MCP Server API Key (optional if Figma MCP is disabled)
export FIGMA_API_KEY="your-figma-api-key"

# Bitig Task Tracker MCP Server URL & API Token
export BITIG_MCP_URL="https://your-bitig-instance.example.com/mcp"
export BITIG_API_TOKEN="your-bitig-api-token"

# Absolute path to your Node.js bin directory (e.g., via nvm) for stdio MCP servers
export NVM_NODE_BIN="/path/to/.nvm/versions/node/v22.0.0/bin"
